<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- English plural forms for counted keys of Localizable.strings. Other
     languages word these without a plural ("елементів: %lld"). -->
<plist version="1.0">
<dict>
	<key>Remove %lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Remove %#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item</string>
			<key>other</key>
			<string>%lld items</string>
		</dict>
	</dict>
	<key>Remove %lld items permanently?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Remove %#@items@ permanently?</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item</string>
			<key>other</key>
			<string>%lld items</string>
		</dict>
	</dict>
</dict>
</plist>
